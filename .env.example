# Copy to .env and fill in. Never commit .env.

# Which LLM provider to use: "groq", "xai" (Grok), "anthropic", "openai" or "mock".
# ("mock" is an offline deterministic smoke-test provider with no LLM — NOT for real use.)
LLM_PROVIDER=groq

# Optional: fallback chain, comma-separated. Bare names reuse the per-provider env below;
# explicit entries are label|base_url|api_key|model.
# LLM_PROVIDERS=groq,openai
# LLM_PROVIDERS=groq|https://api.groq.com/openai/v1|gsk-key|openai/gpt-oss-120b,openai|https://api.openai.com/v1|sk-key|gpt-4o-mini
#
# Optional: ordered Groq key rotation for keys your team is authorized to use
# for this application. Respect Groq's terms and the per-account limits tied to
# each key; do not share credentials contrary to the provider's rules.
# Entries are tried left-to-right. If an entry hits 429/timeout/5xx, DevMate
# logs an [LLM FALLBACK] line and tries the next authorized entry. When this is
# set, it overrides LLM_PROVIDER — but the run still fails if every key is
# exhausted or rejected.
# LLM_PROVIDERS=groq1|https://api.groq.com/openai/v1|gsk-key-1|openai/gpt-oss-120b,groq2|https://api.groq.com/openai/v1|gsk-key-2|openai/gpt-oss-120b,groq3|https://api.groq.com/openai/v1|gsk-key-3|openai/gpt-oss-120b,groq4|https://api.groq.com/openai/v1|gsk-key-4|openai/gpt-oss-120b,groq5|https://api.groq.com/openai/v1|gsk-key-5|openai/gpt-oss-120b
LLM_PROVIDERS=

# Groq Cloud settings (used when LLM_PROVIDER=groq) — free tier available at console.groq.com
GROQ_API_KEY=gsk-your-free-tier-key-here
# llama-3.3-70b-versatile and llama-3.1-8b-instant were shut down for
# free/developer tiers on 2026-08-16; use openai/gpt-oss-120b or openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Grok / xAI settings (used when LLM_PROVIDER=xai; GROK_API_KEY also accepted)
XAI_API_KEY=xai-your-key-here
XAI_MODEL=grok-4-latest
XAI_BASE_URL=https://api.x.ai/v1

# Anthropic settings
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI settings (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Agent loop limits
MAX_ATTEMPTS=3
COMMAND_TIMEOUT=60
# Lower this (e.g. 8) if you hit free-tier rate limits (tokens/requests per minute).
MAX_TOOL_STEPS=12

# Phase 2 limits
RUN_TIMEOUT=900          # overall wall-clock cap for one run (seconds)
CLONE_TIMEOUT=120        # git clone timeout for GitHub URLs (seconds)
MAX_REPO_MB=50           # refuse to clone repos larger than this
READ_CACHE_CHARS=24000   # cap on already-read file contents replayed into prompts
