# Copy to .env and fill in. Never commit .env.
# Never paste real keys into chat, issues, logs or screenshots; once exposed, rotate them.
# Fixora does not copy real .env files into the agent sandbox, but you must still keep them secret.

# Which LLM provider to use: "groq", "xai" (Grok), "anthropic", "openai" or "mock".
# ("mock" is an offline deterministic smoke-test provider with no LLM — NOT for real use.)
LLM_PROVIDER=groq

# Optional: fallback chain, comma-separated. Bare names reuse the per-provider env below;
# explicit entries are label|base_url|api_key|model.
# LLM_PROVIDERS=groq,openai
# LLM_PROVIDERS=groq|https://api.groq.com/openai/v1|gsk-key|openai/gpt-oss-120b,openai|https://api.openai.com/v1|sk-key|gpt-4o-mini
#
# Optional: ordered Groq key rotation for keys your team is authorized to use
# for this application. Respect Groq's terms and the per-account limits tied to
# each key; do not share credentials contrary to the provider's rules.
# Entries are tried left-to-right. If an entry hits 429/timeout/5xx, Fixora
# logs an [LLM FALLBACK] line and tries the next authorized entry. When this is
# set, it overrides LLM_PROVIDER — but the run still fails if every key is
# exhausted or rejected.
# LLM_PROVIDERS=groq1|https://api.groq.com/openai/v1|gsk-key-1|openai/gpt-oss-120b,groq2|https://api.groq.com/openai/v1|gsk-key-2|openai/gpt-oss-120b,groq3|https://api.groq.com/openai/v1|gsk-key-3|openai/gpt-oss-120b,groq4|https://api.groq.com/openai/v1|gsk-key-4|openai/gpt-oss-120b,groq5|https://api.groq.com/openai/v1|gsk-key-5|openai/gpt-oss-120b
LLM_PROVIDERS=

# Groq Cloud settings (used when LLM_PROVIDER=groq) — free tier available at console.groq.com
GROQ_API_KEY=gsk-your-free-tier-key-here
# llama-3.3-70b-versatile and llama-3.1-8b-instant were shut down for
# free/developer tiers on 2026-08-16; use openai/gpt-oss-120b or openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Grok / xAI settings (used when LLM_PROVIDER=xai; GROK_API_KEY also accepted)
XAI_API_KEY=xai-your-key-here
XAI_MODEL=grok-4-latest
XAI_BASE_URL=https://api.x.ai/v1

# Anthropic settings
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI settings (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Agent loop limits
MAX_ATTEMPTS=3
COMMAND_TIMEOUT=60
# Lower this (e.g. 8) if you hit free-tier rate limits (tokens/requests per minute).
MAX_TOOL_STEPS=12

# Phase 2 limits
RUN_TIMEOUT=900          # overall wall-clock cap for one run (seconds)
CLONE_TIMEOUT=120        # git clone timeout for GitHub URLs (seconds)
MAX_REPO_MB=50           # refuse to clone repos larger than this
READ_CACHE_CHARS=24000   # cap on already-read file contents replayed into prompts


# Phase 4: dependency installation
# Allows the agent's install_dependencies tool to install the repository's OWN
# declared dependencies (requirements.txt, or pyproject.toml [project] deps)
# into an isolated temp directory so pytest can import them via PYTHONPATH.
# The tool never accepts package names from the model, never touches the host
# interpreter, and installs into a temp dir deleted with the run.
# Set to 0/false to disable.
FIXORA_ALLOW_DEPENDENCY_INSTALL=1
FIXORA_INSTALL_TIMEOUT=300   # seconds

# Force reasoning effort for all LLM calls to low|medium|high.
# On reasoning models (e.g. GPT-OSS) this is often the biggest latency lever.
# Unset = automatic heuristic selection.
FIXORA_REASONING_EFFORT=

# Prompt size guards (Groq's on_demand tier serves gpt-oss-120b at 8k TPM).
# Every LLM call in the fix loop is compacted to FIXORA_CONTEXT_BUDGET_CHARS
# (head + contiguous tail; ~18k chars ≈ 4.5k tokens); if the model still
# rejects the request as too large, one transparent retry runs with half the
# budget. Already-read file contents are replayed into prompts elided to
# FIXORA_READ_BLOCK_CHARS (oldest reads first).
FIXORA_CONTEXT_BUDGET_CHARS=18000
FIXORA_READ_BLOCK_CHARS=8000

# Retrieval-Augmented Generation: hybrid BM25 + local vectors over AST chunks,
# offline, no keys, no cost. fastembed (BAAI/bge-small-en-v1.5, 384-dim) is the
# preferred embedder and ships in requirements.txt; `auto` uses it when it is
# installed and transparently falls back to the pure-stdlib hashed bag-of-n-grams
# model otherwise (zero network). Set FIXORA_EMBEDDER=hash to pin the offline
# fallback, or FIXORA_RAG=0 to disable retrieval entirely.
FIXORA_RAG=1
FIXORA_EMBEDDER=auto
# Groq-powered query expansion/reranking on top of hybrid retrieval.
# Default ON. Falls back to local ranking on any LLM error/timeout/invalid JSON;
# never blocks a run. Set to 0 to disable.
FIXORA_QUERY_REWRITE=1
FIXORA_RERANK=1

# Cross-run memory: a small JSON lesson store (logs/memory.json). Hints from
# past runs are injected into analyse as labelled hints, never ground truth,
# never bypassing the approval gate. Set to 0 to disable load AND save.
FIXORA_MEMORY=1
# FIXORA_MEMORY_PATH=logs/memory.json

# Dependency install size limit (MB): pip --target tree above this size fails fast.
FIXORA_INSTALL_MAX_MB=512
